APP_NAME="WebRajya ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Internal Docker MySQL Database Configuration
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=webrajya
DB_USERNAME=webrajya
DB_PASSWORD=webrajya_secure_pass

# Licensing Configuration
LICENSE_BYPASS_TESTING=false

# Session & Cache (Stored reliably in MySQL)
SESSION_DRIVER=database
SESSION_LIFETIME=240
CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

# Mail Settings (default log, configurable by CA)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="office@webrajya.in"
MAIL_FROM_NAME="WebRajya ERP"

# WhatsApp Cloud API (optional, can be configured in settings)
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=meta_cloud

